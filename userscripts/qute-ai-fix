#!/bin/bash
# qute-ai-fix — AI-powered per-site fix engine for qutebrowser
#
# Analyzes the current page for cookie banners, overlaid consent walls and ad
# containers that slipped past the filter lists, saves the fixes per domain,
# and applies them automatically on the next visit.
#
# It ALSO checks for JavaScript over-blocking: bin/ai-fix-overblocking asks the
# real block engine whether this page's own scripts/assets are being dropped, and
# reads the on-page bot / anti-adblock signatures. The evidence is recorded in the
# fix file under "js_overblocking" and reported, so a page that is blank because
# our blocking (or a bot challenge) killed its JS is not mistaken for a CSS defect.
#
#   Keybinding: ,af  (AI Fix)
#   Usage:      spawn --userscript qute-ai-fix
#
# Fixes are stored in:
#   ~/.local/state/omarchy-qutebrowser/site-fixes/<domain>.json
# and turned into per-domain Greasemonkey scripts by config/site-overrides.py
# (sourced from config.py), so a fix for one site never affects another.

set -euo pipefail

# ── Helpers ───────────────────────────────────────────────────────────────────
msg() { [[ -n "${QUTE_FIFO:-}" ]] && printf "message-info '%s'\n"  "${1//\'/\'\\\'\'}" >> "$QUTE_FIFO" || true; }
err() { [[ -n "${QUTE_FIFO:-}" ]] && printf "message-error '%s'\n" "${1//\'/\'\\\'\'}" >> "$QUTE_FIFO" || true; }

# ── Validate env ──────────────────────────────────────────────────────────────
URL="${QUTE_URL:-}"
HTML_FILE="${QUTE_HTML:-}"
[[ -z "$URL" ]]       && { err "qute-ai-fix: no URL (run as userscript)"; exit 1; }
[[ -z "$HTML_FILE" ]] && { err "qute-ai-fix: no QUTE_HTML (run as userscript)"; exit 1; }
[[ ! -f "$HTML_FILE" ]] && { err "qute-ai-fix: HTML file missing"; exit 1; }

# ── Domain extraction (URL passed as argv, never interpolated into code) ───────
DOMAIN=$(python3 -c 'import sys; from urllib.parse import urlparse; print(urlparse(sys.argv[1]).netloc)' "$URL" 2>/dev/null || true)
[[ -z "$DOMAIN" ]] && { err "qute-ai-fix: could not extract domain from URL"; exit 1; }

# ── State directory ───────────────────────────────────────────────────────────
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-qutebrowser/site-fixes"
mkdir -p "$STATE_DIR"
FIX_FILE="$STATE_DIR/${DOMAIN}.json"

# The plugin root, so we can reach bin/ai-fix-overblocking whether this script is run from the
# repository or through the ~/.local/share/qutebrowser/userscripts symlink.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
PLUGIN_DIR="$(dirname "$(dirname "$SELF")")"
OVERBLOCK_TOOL="$PLUGIN_DIR/bin/ai-fix-overblocking"

msg "qute-ai-fix: analyzing $DOMAIN …"

# ── Prepare page sample for LLM ──────────────────────────────────────────────
# Extract a compact representation: head + body start (avoid sending megabytes)
PAGE_SAMPLE=$(python3 << 'PYEOF'
import os, re, sys

html_file = os.environ.get("QUTE_HTML", "")
if not html_file or not os.path.exists(html_file):
    print("(no html)")
    sys.exit(0)

with open(html_file, encoding="utf-8", errors="replace") as f:
    html = f.read(80000)  # max 80KB

# Strip scripts and styles content (keep tags for analysis)
html = re.sub(r'<script[^>]*>.*?</script>', '<script>…</script>', html, flags=re.DOTALL | re.I)
html = re.sub(r'<style[^>]*>.*?</style>', '<style>…</style>', html, flags=re.DOTALL | re.I)
# Collapse whitespace
html = re.sub(r'\s{3,}', ' ', html)

print(html[:15000])
PYEOF
)

# ── Is our blocking breaking this page's JavaScript? ──────────────────────────
# The other half of a broken page: our own ad/tracker blocking stopping scripts the page
# needs. bin/ai-fix-overblocking asks the REAL block engine about this page's own subresources
# (script/link/iframe src, fetch/import/XHR) plus qutebrowser's parsed hosts blocker, and reads
# the on-page bot/anti-adblock signatures. A bot challenge is NOT over-blocking, and the tool
# says so — which matters, because a fingerprint refusal looks identical to a blocked page.
OVERBLOCK=""
if [[ -x "$OVERBLOCK_TOOL" ]]; then
  OVERBLOCK=$(QUTE_URL="$URL" QUTE_HTML="$HTML_FILE" python3 "$OVERBLOCK_TOOL" 2>/dev/null || true)
fi
[[ -z "$OVERBLOCK" ]] && OVERBLOCK='{}'

OVERBLOCK_SUMMARY=$(printf '%s' "$OVERBLOCK" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("(over-blocking check unavailable)"); raise SystemExit(0)
if "error" in d:
    print("(over-blocking check unavailable: %s)" % d["error"]); raise SystemExit(0)
print("verdict: %s" % d.get("verdict", "?"))
print("page subresources checked: %s; blocked: %s (first-party: %s)"
      % (d.get("checked", 0), d.get("blocked_count", 0), d.get("first_party_blocked", 0)))
for b in (d.get("blocked") or [])[:10]:
    print("  BLOCKED [%s / by %s] %s" % (b.get("party"), b.get("by"), b.get("url")))
for s in (d.get("signals") or []):
    print("  SIGNAL: %s" % s)
' 2>/dev/null || echo "(over-blocking check unavailable)")

# ── Call LLM ──────────────────────────────────────────────────────────────────
PROMPT=$(cat << PROMPT
You are a qutebrowser site-fix assistant. Analyze the page below and return a JSON object with fixes.

URL: $URL
Domain: $DOMAIN

PAGE HTML (truncated):
$PAGE_SAMPLE

BLOCKING EVIDENCE (measured against the real block engine, not guessed): whether this page's own
JavaScript and assets are being blocked, and the on-page bot / anti-adblock signatures:
$OVERBLOCK_SUMMARY

Return ONLY valid JSON in this exact format (no markdown, no explanation):
{
  "domain": "$DOMAIN",
  "notes": "one-line summary of what was found and fixed",
  "css_hide": [
    "CSS selector for element to hide (e.g. #cookie-banner)"
  ],
  "css_override": [
    "CSS rule to inject verbatim (e.g. body { overflow: auto !important; })"
  ],
  "adblock_rules": [
    "uBlock/EasyList COSMETIC filter only, e.g. ##.ad-container or example.com##.ad"
  ]
}

Rules:
- css_hide: selectors for cookie banners, consent overlays, paywall walls, ad containers that slipped through
- css_override: CSS fixes for scroll-lock (overflow:hidden on body/html), position:fixed overlays, pointer-events blocking
- adblock_rules: ONLY cosmetic filters of the form ##selector (they are applied as CSS on this domain only). Do NOT emit network rules (||..., @@..., anything with $).
- Keep every array small (max 10 items) and precise — overly broad selectors break pages
- If nothing needs fixing, return empty arrays
- BLOCKING: trust the evidence above. If it reports an anti-adblock wall or a bot challenge, say
  so in "notes" and do NOT attribute the breakage to CSS. If it reports the page's own
  (first-party) resources blocked, name them in "notes" — a cosmetic fix cannot unblock a network
  request, so still emit only the cosmetic/CSS fixes you can see, and do not invent a workaround.
PROMPT
)

RESPONSE=$(hermes -z "$PROMPT" --cli 2>/dev/null | grep -A999 "^{" | head -100 || echo "")

# ── Parse and validate response ───────────────────────────────────────────────
if [[ -z "$RESPONSE" ]]; then
  err "qute-ai-fix: LLM returned no response"
  exit 1
fi

# Extract JSON (handle case where LLM wraps it in markdown)
JSON=$(printf '%s' "$RESPONSE" | python3 -c "
import sys, json, re
raw = sys.stdin.read()
m = re.search(r'\{.*\}', raw, re.DOTALL)
if not m:
    sys.exit(1)
try:
    d = json.loads(m.group())
    d.setdefault('domain', '')
    d.setdefault('notes', '')
    d.setdefault('css_hide', [])
    d.setdefault('css_override', [])
    d.setdefault('adblock_rules', [])
    for key in ('css_hide', 'css_override', 'adblock_rules'):
        if not isinstance(d.get(key), list):
            d[key] = []
    print(json.dumps(d, indent=2))
except Exception:
    sys.exit(1)
" 2>/dev/null) || { err "qute-ai-fix: could not parse LLM response"; exit 1; }

# ── Save fix file ─────────────────────────────────────────────────────────────
# Fold the over-blocking evidence in as a field of its own. It is measured, not generated by the
# LLM, so it must not depend on the model reproducing it — site-overrides.py ignores keys it does
# not know, so an extra field is safe.
JSON=$(printf '%s' "$JSON" | OVERBLOCK="$OVERBLOCK" python3 -c '
import json, os, sys
d = json.load(sys.stdin)
try:
    ob = json.loads(os.environ.get("OVERBLOCK") or "{}")
except Exception:
    ob = {}
if isinstance(ob, dict) and ob and "error" not in ob:
    d["js_overblocking"] = ob
else:
    d.setdefault("js_overblocking", {})
print(json.dumps(d, indent=2))
' 2>/dev/null || printf '%s' "$JSON")
printf '%s\n' "$JSON" > "$FIX_FILE"

# ── Apply: regenerate the per-domain Greasemonkey script and hot-reload ───────
# config/site-overrides.py (sourced by config.py) turns the saved JSON into
# greasemonkey/omarchy-sitefix-<domain>.js. config-source re-runs it; then the
# reload command makes the running instance pick up the new script.
if [[ -n "${QUTE_FIFO:-}" ]]; then
  printf 'config-source\n'      >> "$QUTE_FIFO"
  printf 'greasemonkey-reload\n' >> "$QUTE_FIFO"
fi

# ── Report ────────────────────────────────────────────────────────────────────
NOTES=$(printf '%s' "$JSON" | python3 -c "import sys,json; print(json.load(sys.stdin).get('notes',''))" 2>/dev/null || true)
CSS_COUNT=$(printf '%s' "$JSON" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d.get('css_hide',[]))+len(d.get('css_override',[])))" 2>/dev/null || echo 0)
RULE_COUNT=$(printf '%s' "$JSON" | python3 -c "import sys,json; print(len(json.load(sys.stdin).get('adblock_rules',[])))" 2>/dev/null || echo 0)
VERDICT=$(printf '%s' "$JSON" | python3 -c "import sys,json; print((json.load(sys.stdin).get('js_overblocking') or {}).get('verdict',''))" 2>/dev/null || true)

msg "qute-ai-fix [$DOMAIN]: $NOTES (${CSS_COUNT} CSS fixes, ${RULE_COUNT} adblock rules)"
[[ -n "$VERDICT" ]] && msg "qute-ai-fix blocking check: $VERDICT"
msg "qute-ai-fix: fixes active — reload the page (r) to see them"
