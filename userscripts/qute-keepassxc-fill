FILL_JS_TEMPLATE = r"""
(function () {
  var USER = __USER__, PASS = __PASS__, ADVANCE = __ADVANCE__;

  function visible(el) {
    try {
      if (!el || el.disabled || el.readOnly) return false;
      if (el.type === 'hidden') return false;
      if (el.getAttribute('aria-hidden') === 'true') return false;
      if (el.tabIndex === -1) return false;
      var s = el.ownerDocument.defaultView.getComputedStyle(el);
      if (!s || s.display === 'none' || s.visibility !== 'visible' || s.opacity === '0') return false;
      var r = el.getBoundingClientRect();
      if (!el.offsetWidth || !el.offsetHeight || r.width === 0 || r.height === 0) return false;
      return true;
    } catch (e) { return false; }
  }

  function setValue(el, value) {
    try {
      var proto = (el.tagName === 'TEXTAREA') ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
      var desc = Object.getOwnPropertyDescriptor(proto, 'value');
      if (desc && desc.set) { desc.set.call(el, value); } else { el.value = value; }
    } catch (e) { el.value = value; }
    ['input', 'change', 'keyup', 'blur'].forEach(function (type) {
      try {
        var ev = (type === 'keyup')
          ? new KeyboardEvent(type, { bubbles: true })
          : new Event(type, { bubbles: true });
        el.dispatchEvent(ev);
      } catch (e) {}
    });
  }

  // What counts as visible for an input (tabIndex -1 disqualifies a field) is too
  // strict for a button: Google's Next is a plain <div role="button"> with
  // tabIndex -1, which would make the press silently do nothing.
  function clickable(el) {
    try {
      if (!el || el.disabled) return false;
      var s = el.ownerDocument.defaultView.getComputedStyle(el);
      if (!s || s.display === 'none' || s.visibility !== 'visible' || s.opacity === '0') return false;
      var r = el.getBoundingClientRect();
      if (r.width === 0 || r.height === 0) return false;
      return true;
    } catch (e) { return false; }
  }

  function textish(el) {
    return el.tagName === 'INPUT' &&
      ['text', 'email', 'tel', ''].indexOf(el.type) !== -1;
  }

  function scoreUsername(el) {
    var ac = (el.getAttribute('autocomplete') || '').toLowerCase();
    var hay = ((el.id || '') + ' ' + (el.name || '') + ' ' +
               (el.getAttribute('aria-label') || '') + ' ' +
               (el.getAttribute('placeholder') || '')).toLowerCase();
    var s = 0;
    if (/\busername\b/.test(ac)) s += 100;
    if (el.type === 'email') s += 60;
    if (/(user|email|login|ident|account|phone|userid|user_name|mail)/.test(hay)) s += 50;
    if (/(search|query|otp|totp|code|captcha|verify|password)/.test(hay)) s -= 200;
    return s;
  }

  function collect() {
    var all = Array.prototype.slice.call(document.querySelectorAll('input, textarea'));
    // Real fields sometimes live inside an open shadow root.
    try {
      var hosts = Array.prototype.slice.call(document.querySelectorAll('*'));
      for (var i = 0; i < hosts.length && i < 5000; i++) {
        if (!hosts[i].shadowRoot) continue;
        var inner = hosts[i].shadowRoot.querySelectorAll('input, textarea');
        for (var j = 0; j < inner.length; j++) all.push(inner[j]);
      }
    } catch (e) {}
    function plausible(el) {
      if (!el || el.type === 'hidden' || el.disabled) return false;
      // A decoy field is not the one to type into (Google's identifier page ships
      // <input name="hiddenPassword"> to catch password managers).
      var tag = ((el.id || '') + ' ' + (el.name || '')).toLowerCase();
      return !/hidden|decoy|_fake/.test(tag);
    }
    var ok = all.filter(plausible);
    var vis = ok.filter(visible);
    return vis.length ? vis : ok;      // layout-less fields still beat filling nothing
  }

  var fields = collect();
  var pwEl = fields.filter(function (e) { return e.type === 'password'; })[0] || null;

  var best = -1, bestEl = null;
  fields.forEach(function (e) {
    if (!textish(e) || e === pwEl) return;
    var s = scoreUsername(e);
    if (s > best) { best = s; bestEl = e; }
  });

  var userEl = null;
  if (best > 0) {
    userEl = bestEl;                                            // strong username signal
  } else if (pwEl) {
    // A login form is present (visible password field) but no well-labelled
    // username field: use the first text-ish field.
    userEl = fields.filter(function (e) { return textish(e) && e !== pwEl; })[0] || null;
  }

  var done = [];
  if (userEl) { setValue(userEl, USER); done.push('username'); }
  if (pwEl)   { setValue(pwEl, PASS); done.push('password'); }
  if (done.length === 0) return 'no-fields';

  // ── advance the flow ───────────────────────────────────────────────────────
  // A two-step login (Microsoft, Google) shows only the identifier first: the
  // password page does not exist until "Next" is pressed, so filling the username
  // and stopping made it look like the fill had done nothing there.
  function nextControl(from) {
    var ids = ['identifierNext', 'passwordNext', 'idSIButton9', 'submitButton',
               'next', 'submit', 'login', 'signIn', 'continue'];
    for (var i = 0; i < ids.length; i++) {
      var el = document.getElementById(ids[i]);
      if (el && clickable(el)) return el;
    }
    var form = from && from.form;
    if (form) {
      var sub = form.querySelector('button[type=submit], input[type=submit]');
      if (sub && clickable(sub)) return sub;
    }
    var cands = Array.prototype.slice.call(document.querySelectorAll(
      'button, [role=button], input[type=submit]'));
    var want = /^(next|weiter|continue|sign in|log in|login|anmelden|einloggen|submit|los)$/i;
    var avoid = /(show|anzeigen|reveal|forgot|vergessen|abbrechen|cancel)/i;
    for (var k = 0; k < cands.length; k++) {
