#!/usr/bin/env python3
"""qute-keepassxc-fill — fill website logins from KeePassXC in qutebrowser.

A focused, MIT-licensed replacement for qutebrowser's bundled `qute-keepassxc`
userscript. It speaks the same KeePassXC-Browser socket protocol (so it reuses
your existing association) but fills forms far more robustly — which is what the
multi-step Google / Microsoft / Apple sign-in pages need:

  * hides are respected — never writes into a hidden/aria-hidden decoy password
    field (Google's identifier page ships one: <input name="hiddenPassword">)
  * fills a username/email field even when it lives on a page without any
    password field (Google step 1, Microsoft `loginfmt`), by scoring visible
    fields on autocomplete/type/name/id instead of "first form with a password"
  * fills only VISIBLE password fields
  * sets values through the native value setter and dispatches input/change/
    keyup/blur so React/Vue/Angular-style frameworks register the value
  * multi-account selection uses `gum`/`fzf` in a floating terminal when rofi
    is not installed

Usage (config.py):
    config.bind("pw",  "spawn --userscript qute-keepassxc-fill", mode="normal")
    config.bind("<Alt-Shift-u>", "spawn --userscript qute-keepassxc-fill", mode="insert")
    config.bind("pt",  "spawn --userscript qute-keepassxc-fill --totp", mode="normal")
"""

import argparse
import base64
import json
import os
import socket
import subprocess
import sys
import tempfile
import time

try:
    import nacl.public
    import nacl.utils
except ImportError:  # pragma: no cover - depends on the runtime interpreter
    _hint = ("qute-keepassxc-fill needs PyNaCl for the interpreter that runs it "
             "(%s). Install it: for /usr/bin/python3 run 'omarchy pkg add python-pynacl'; "
             "for a PATH python3 run 'python3 -m pip install pynacl'." % sys.executable)
    print(_hint, file=sys.stderr)
    _fifo = os.environ.get("QUTE_FIFO")
    if _fifo:
        try:
            with open(_fifo, "w") as _fh:
                _fh.write('message-error "%s"\n' % _hint.replace('"', '\\"'))
        except OSError:
            pass
    sys.exit(1)

SOCKET_DEFAULT = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()),
    "org.keepassxc.KeePassXC.BrowserServer",
)


def parse_args():
    p = argparse.ArgumentParser(description="Fill logins from KeePassXC")
    p.add_argument("url", nargs="?", default=os.environ.get("QUTE_URL"))
    p.add_argument("--totp", action="store_true", help="fill the focused TOTP field")
    p.add_argument("--fill-only", action="store_true",
                   help="only fill the fields — do not press Next/Submit")
    p.add_argument("--pick", action="store_true",
                   help="choose among several accounts for this domain (gum picker)")
    p.add_argument("--account", metavar="N|LOGIN|UUID|TITLE",
                   help="use this match (1-based number, login, uuid prefix or title)")
    p.add_argument("--forget", action="store_true",
                   help="forget the remembered account for this domain")
    p.add_argument("--socket", "-s", default=SOCKET_DEFAULT)
    p.add_argument("--key-file", default=None,
                   help="association key file (default: $QUTE_DATA_DIR/keepassxc.key)")
    p.add_argument("--insecure", action="store_true",
                   help="accepted for compatibility; the plugin stores the key unencrypted")
    return p.parse_args()


SOCKET_TIMEOUT = 8          # seconds; a hung peer must surface as an error


class KpError(Exception):
    def __init__(self, code, desc):
        super().__init__("KeePassXC error [%s]: %s" % (code, desc))
        self.code = code
        self.description = desc


class KeePassXC:
    """Minimal client for the KeePassXC-Browser socket protocol."""

    def __init__(self, *, key_seed, client_id=None, socket_path):
        self.socket_path = socket_path
        self.client_id = client_id
        self.client_key = nacl.public.PrivateKey.generate()
        self.id_key = nacl.public.PrivateKey.from_seed(key_seed)
        self.box = None
        self.sock = None

    # -- transport ---------------------------------------------------------
    def connect(self):
        if not os.path.exists(self.socket_path):
            raise KpError(-1, "KeePassXC browser socket not found (is Browser Integration enabled?)")
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(self.socket_path)
        # Without a timeout a KeePassXC that accepts the connection but never answers
        # left the keypress hanging forever: no message, no fill, nothing until killed.
        self.sock.settimeout(SOCKET_TIMEOUT)
        self.client_id = base64.b64encode(nacl.utils.random(nacl.public.Box.NONCE_SIZE)).decode()

        self._send_plain({
            "action": "change-public-keys",
            "publicKey": base64.b64encode(self.client_key.public_key.encode()).decode(),
            "nonce": base64.b64encode(nacl.utils.random(nacl.public.Box.NONCE_SIZE)).decode(),
            "clientID": self.client_id,
        })
        resp = self._recv_plain()
        if resp.get("action") != "change-public-keys" or str(resp.get("success")) != "true":
            raise KpError(-1, "handshake failed: %s" % resp)
        self.box = nacl.public.Box(self.client_key,
                                   nacl.public.PublicKey(base64.b64decode(resp["publicKey"])))

    def _send_plain(self, payload):
        self.sock.send(json.dumps(payload).encode())

    def _recv_plain(self):
        # A Unix stream socket has no message boundaries: one recv() can return
        # only part of a large reply (e.g. get-logins with many matching entries),
        # which would fail to parse. Read until the JSON is complete.
        chunks = []
        while True:
            try:
                chunk = self.sock.recv(65536)
            except (BlockingIOError, InterruptedError):
                continue
            if not chunk:
                break
            chunks.append(chunk)
            try:
                json.loads(b"".join(chunks).decode())
                break
            except ValueError:
                continue
        data = b"".join(chunks)
        if not data:
            raise KpError(-1, "empty response from KeePassXC")
        return json.loads(data.decode())

    def _send(self, payload, **top):
        nonce = nacl.utils.random(nacl.public.Box.NONCE_SIZE)
        cipher = self.box.encrypt(json.dumps(payload).encode(), nonce).ciphertext
        msg = {"action": payload["action"],
               "message": base64.b64encode(cipher).decode(),
               "nonce": base64.b64encode(nonce).decode(),
               "clientID": self.client_id}
        msg.update(top)
        self._send_plain(msg)

    def _recv(self):
        resp = self._recv_plain()
        if "error" in resp:
            raise KpError(resp.get("errorCode", -1), resp.get("error", "unknown"))
        return json.loads(self.box.decrypt(base64.b64decode(resp["message"]),
                                           base64.b64decode(resp["nonce"])).decode())

    # -- actions -----------------------------------------------------------
    def test_associate(self, assoc_id):
        if not assoc_id:
            return False
        self._send({"action": "test-associate", "id": assoc_id,
                    "key": base64.b64encode(self.id_key.public_key.encode()).decode()},
                   triggerUnlock="true")
        return str(self._recv().get("success")) == "true"

    def associate(self):
        self._send({"action": "associate",
                    "key": base64.b64encode(self.client_key.public_key.encode()).decode(),
                    "idKey": base64.b64encode(self.id_key.public_key.encode()).decode()})
        return self._recv()["id"]

    def get_logins(self, url):
        self._send({"action": "get-logins", "url": url,
                    "keys": [{"id": self.assoc_id,
                              "key": base64.b64encode(self.id_key.public_key.encode()).decode()}]})
        return self._recv().get("entries") or []

    def get_totp(self, uuid):
        self._send({"action": "get-totp", "uuid": uuid})
        resp = self._recv()
        if str(resp.get("success")) != "true" or not resp.get("totp"):
            return None
        return resp["totp"]


class KeyStore:
    """Reuse the association key qutebrowser's bundled qute-keepassxc stored."""

    def __init__(self, path=None):
        data_dir = os.environ.get("QUTE_DATA_DIR") or os.path.join(
            os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "qutebrowser")
        self.path = path or os.path.join(data_dir, "keepassxc.key")

    def exists(self):
        return os.path.isfile(self.path)

    def load(self):
        data = json.loads(open(self.path).read())
        return data["id"], base64.b64decode(data["key"])

    def store(self, assoc_id, key_seed):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(self.path, "w") as fh:
            json.dump({"id": assoc_id, "key": base64.b64encode(key_seed).decode()}, fh)
        os.chmod(self.path, 0o600)


# --------------------------------------------------------------------------- #
# qutebrowser plumbing
# --------------------------------------------------------------------------- #
def one_line(js):
    """Collapse a JS snippet onto ONE line, comments stripped.

    qutebrowser reads the userscript FIFO line by line and executes each line as
    its own command (qutebrowser/commands/userscripts.py: the Fifo object emits
    got_line per line), so a multi-line `jseval` never runs — only the first
    fragment is executed and every following JS line is mistaken for a command.

    Two things this must get right:
      * a trailing `// comment` would swallow the rest of the joined line, and
      * whitespace inside a string literal (a password with two spaces!) must be
        left alone, so only whitespace *outside* quotes is collapsed.
    """
    out, i, n = [], 0, len(js)
    quote = None
    space = False
    while i < n:
        ch = js[i]
        if quote:                                   # inside '…' or "…" — verbatim
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(js[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "\"'`":
            if space and out:
                out.append(" ")
            space = False
            quote = ch
            out.append(ch)
            i += 1
            continue
        if ch == "/" and i + 1 < n and js[i + 1] == "/":        # line comment
            i += 2
            while i < n and js[i] != "\n":
                i += 1
            continue
        if ch == "/" and i + 1 < n and js[i + 1] == "*":        # block comment
            i += 2
            while i + 1 < n and not (js[i] == "*" and js[i + 1] == "/"):
                i += 1
            i += 2
            continue
        if ch in " \t\r\n":
            space = True
            i += 1
            continue
        if space and out:
            out.append(" ")
        space = False
        out.append(ch)
        i += 1
    return "".join(out).strip()


def qute(cmd):
    # One line == one command; a stray newline would silently break the command.
    if "\n" in cmd or "\r" in cmd:
        raise ValueError("qutebrowser FIFO commands must be a single line")
    with open(os.environ["QUTE_FIFO"], "w") as fifo:
        fifo.write(cmd + "\n")
        fifo.flush()


def msg(text):
    """Informational message in qutebrowser's status bar."""
    text = " ".join(str(text).splitlines())
    qute('message-info "%s"' % text.replace('"', '\\"'))


def error(msg):
    # Never smuggle a newline (or a bare quote) into the FIFO command.
    msg = " ".join(str(msg).splitlines())
    print(msg, file=sys.stderr)
    qute('message-error "%s"' % msg.replace('"', '\\"'))


# --------------------------------------------------------------------------- #
# Account selection
# ---------------------------------------------------------------------------- #
# When several entries match a domain (two logins on one site, a personal and a
# work account, ...) the choice is made like this:
#
#   ,pw          fill the remembered account; pressing it again advances to the
#                next match for that domain (the status line says which and how
#                many there are)
#   ,ka          open a picker (gum, in a floating terminal) and remember the
#                choice for that domain
#   --account N  use match N (1-based) directly; a login, uuid prefix or title
#                substring also works — and it is remembered
#   --forget     forget the remembered account for this domain
#
# The memory lives in $XDG_STATE_HOME/omarchy-qutebrowser/keepassxc/accounts.json.
def account_label(cred, i):
    """One human-readable line: group · title — login."""
    group = str(cred.get("group") or "").strip()
    name = str(cred.get("name") or cred.get("title") or "").strip()
    login = str(cred.get("login") or cred.get("userName") or "").strip()
    bits = [b for b in (group, name) if b]
    label = " · ".join(bits) if bits else "(untitled entry)"
    if login and login not in label:
        label += " — " + login
    return "%d\t%s" % (i + 1, label)


def _prefs_path():
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "omarchy-qutebrowser", "keepassxc", "accounts.json")


def load_prefs():
    try:
        with open(_prefs_path()) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_pref(domain, cred, index=None, rotate=True):
    """Remember which account was chosen for a domain (0600, best effort).

    `rotate` records why: an explicit choice (--account/--pick) is used again next
    time, whereas a plain fill rotates, so pressing the key repeatedly walks the
    matches for that domain.
    """
    prefs = load_prefs()
    prefs[domain] = {
        "login": cred.get("login") or "",
        "name": cred.get("name") or "",
        "uuid": cred.get("uuid") or "",
        "index": index,
        "rotate": bool(rotate),
    }
    path = _prefs_path()
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(prefs, fh, indent=2)
            fh.write("\n")
    except OSError:
        pass


def match_index(creds, spec):
    """Resolve --account N / login / uuid-prefix / title-substring to an index."""
    spec = str(spec).strip()
    if not spec:
        return None
    if spec.isdigit():
        i = int(spec) - 1
        return i if 0 <= i < len(creds) else None
    for i, c in enumerate(creds):
        for key in ("login", "uuid", "name", "title"):
            val = str(c.get(key) or "")
            if val and (val == spec or val.startswith(spec) or spec.lower() in val.lower()):
                return i
    return None


def remembered_index(creds, url, prefs):
    domain = url.split("/")[2] if "//" in url else url
    entry = prefs.get(domain)
    if not entry:
        return None
    for key in ("uuid", "login", "name"):
        want = str(entry.get(key) or "")
        if not want:
            continue
        for i, c in enumerate(creds):
            if str(c.get(key) or "") == want:
                return i
    i = entry.get("index")
    return i if isinstance(i, int) and 0 <= i < len(creds) else None


def open_picker(creds, url):
    """gum in a floating terminal (rofi is usually absent). Returns an index or None."""
    domain = url.split("/")[2] if "//" in url else url
    labels = [account_label(c, i) for i, c in enumerate(creds)]
    listfile = tempfile.NamedTemporaryFile("w", prefix="kpxc-list-", suffix=".txt", delete=False)
    listfile.write("\n".join(labels) + "\n")
    listfile.close()
    outfile = listfile.name + ".out"
    donefile = outfile + ".done"

    # The shell writes `donefile` once gum has exited (chosen OR cancelled). The
    # `> outfile` redirection truncates outfile the moment the terminal launches,
    # so a cancelled picker leaves a 0-byte file and polling the file alone sat
    # here for the full 60 s before reporting "No account selected".
    cmd = ("gum choose --header 'KeePassXC — account for %s' < %s > %s; : > %s"
           % (domain, listfile.name, outfile, donefile))
    try:
        subprocess.Popen(
            ["setsid", "uwsm-app", "--", "xdg-terminal-exec",
             "--app-id=org.omarchy.keepassxc-fill", "--title=KeePassXC — select account",
             "--", "bash", "-c", cmd],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except FileNotFoundError:
        error("No account picker available (install gum) — using the remembered account")
        return None

    deadline = time.time() + 60
    while time.time() < deadline:
        if os.path.exists(donefile):        # the picker finished
            break
        try:
            if os.path.getsize(outfile) > 0:   # fast path: a choice landed
                break
        except OSError:
            pass
        time.sleep(0.3)

    try:
        with open(outfile) as fh:
            choice = fh.read().strip()
    except OSError:
        choice = ""
    finally:
        for p in (listfile.name, outfile, donefile):
            try:
                os.unlink(p)
            except OSError:
                pass

    if choice and "\t" in choice:
        try:
            return int(choice.split("\t", 1)[0]) - 1
        except ValueError:
            pass
    return None


def choose_account(creds, url, args):
    """Pick an entry and remember it. Returns (cred, note)."""
    domain = url.split("/")[2] if "//" in url else url
    prefs = load_prefs()

    if getattr(args, "forget", False):
        if domain in prefs:
            prefs.pop(domain, None)
            try:
                os.makedirs(os.path.dirname(_prefs_path()), mode=0o700, exist_ok=True)
                fd = os.open(_prefs_path(), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as fh:
                    json.dump(prefs, fh, indent=2)
                    fh.write("\n")
            except OSError:
                pass
            msg("KeePassXC: forgot the remembered account for %s" % domain)
        return None, "forgotten"

    if len(creds) == 1:
        return creds[0], ""

    spec = getattr(args, "account", None)
    if spec:
        i = match_index(creds, spec)
        if i is None:
            return None, "no-match:%s" % spec
        save_pref(domain, creds[i], i, rotate=False)
        return creds[i], "chosen %d/%d" % (i + 1, len(creds))

    if getattr(args, "pick", False):
        i = open_picker(creds, url)
        if i is None:
            i = remembered_index(creds, url, prefs)
            if i is None:
                return None, "cancelled"
        save_pref(domain, creds[i], i, rotate=False)
        return creds[i], "picked %d/%d" % (i + 1, len(creds))

    # Default: an explicitly chosen account is used again; otherwise each press
    # advances one match, so several accounts on a domain are switched through with
    # the same key.
    entry = prefs.get(domain) or {}
    i = remembered_index(creds, url, prefs)
    if i is None:
        i = 0
    elif entry.get("rotate"):
        i = (i + 1) % len(creds)
    save_pref(domain, creds[i], i, rotate=True)
    note = "account %d/%d" % (i + 1, len(creds))
    if len(creds) > 1:
        note += " — press again for the next, ,ka to pick"
    return creds[i], note

