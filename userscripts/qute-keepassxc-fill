def fill_js(user, password, advance=True):
    return (FILL_JS_TEMPLATE
            .replace("__USER__", json.dumps(user))
            .replace("__PASS__", json.dumps(password))
            .replace("__ADVANCE__", "true" if advance else "false"))


def totp_js(token):
    return (
        "(function(){var i=document.activeElement;"
        "if(!i||i.tagName!=='INPUT'){return 'no-input';}"
        "i.value=%s;"
        "['input','change','keyup'].forEach(function(t){try{i.dispatchEvent(new Event(t,{bubbles:true}));}catch(e){}});"
        "return 'filled:totp';})();" % json.dumps(token)
    )


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #
def connect_keepassxc(args):
    store = KeyStore(args.key_file)
    if store.exists():
        assoc_id, key_seed = store.load()
        kp = KeePassXC(key_seed=key_seed, client_id=assoc_id, socket_path=args.socket)
        kp.assoc_id = assoc_id
        try:
            kp.connect()
            ok = kp.test_associate(assoc_id)
        except (KpError, OSError) as exc:
            error("KeePassXC: %s" % exc)
            return None
        if not ok:
            # The stored association is dead (KeePassXC restarted, a different database
            # was opened, or the association was removed). Leaving the key file in place
            # made this a DEAD END: the next run took this identical branch and failed
            # identically, so the only recovery was deleting the key by hand.
            try:
                os.remove(store.path)          # store.path is a str, not a Path
            except OSError:
                pass
            error("KeePassXC no longer recognises this association — the stale key was "
                  "removed; press again to re-associate")
            return None
        return kp
    key_seed = nacl.utils.random(32)
    kp = KeePassXC(key_seed=key_seed, socket_path=args.socket)
    kp.connect()
    assoc_id = kp.associate()
    kp.assoc_id = assoc_id
    if not kp.test_associate(assoc_id):
        error("Could not associate with KeePassXC")
        return None
    store.store(assoc_id, key_seed)
    return kp


def main():
    if "QUTE_FIFO" not in os.environ:
        print("qute-keepassxc-fill must be run as a qutebrowser userscript", file=sys.stderr)
        return 1

    try:
        args = parse_args()
        if not args.url:
            error("No URL available")
            return 1

        kp = connect_keepassxc(args)
        if not kp:
            return 1

        creds = kp.get_logins(args.url)
        if not creds:
            error("No KeePassXC credentials match %s" % (args.url.split('/')[2] if '//' in args.url else args.url))
            return 1

        cred, note = choose_account(creds, args.url, args)
        if cred is None:
            if note == "forgotten":
                return 0
            if note.startswith("no-match:"):
                error("KeePassXC: no account matching '%s' on %s"
                      % (note.split(":", 1)[1], args.url.split("/")[2]))
            else:
                error("KeePassXC: no account selected")
            return 1
        if note:
            msg("KeePassXC: %s — %s" % (note.split(" — ")[0], account_label(cred, 0).split("\t", 1)[-1]))
        if not cred:
            error("No account selected")
            return 1

        if args.totp:
            token = kp.get_totp(cred.get("uuid"))
            if not token:
                error("No TOTP configured for this entry")
                return 1
            qute("jseval -q " + one_line(totp_js(token)))
            return 0

        user = cred.get("login") or ""
        password = cred.get("password") or ""
        # Run WITHOUT -q so qutebrowser shows the JS return value — that is the
        # only honest feedback of what happened ("filled:username+password",
        # "filled:username" on a Google/Microsoft first step, or "no-fields"
        # when the page has no fillable input, e.g. an account chooser).
        qute("jseval " + one_line(fill_js(user, password,
                                          advance=not args.fill_only)))
        return 0
    except KpError as exc:
        error(str(exc))
        return 1
    except Exception as exc:  # noqa: BLE001
        error("qute-keepassxc-fill: %s" % exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
