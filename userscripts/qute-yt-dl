#!/bin/bash
# qute-yt-dl — download a video or extract MP3 via yt-dlp.
#
# Invocation (config.py):
#   config.bind(",dv", "spawn --userscript qute-yt-dl video", mode="normal")
#   config.bind(",dm", "spawn --userscript qute-yt-dl mp3",   mode="normal")
#
# Behaviour:
#   * currently ON a video page (youtube.com/watch?v=…, youtu.be/…, /shorts/…)
#       -> that video is downloaded directly ("single video playing" case)
#   * otherwise (search results, channel, playlist overview, any list)
#       -> qutebrowser shows hints on the `ytdl` link group so you pick which
#          video to download; the picked link comes back as argument 2.
#
# $1 = "video" | "mp3"      $2 = URL (optional, supplied by the hint)
# QUTE_URL = current page, QUTE_FIFO = qutebrowser command FIFO

set -euo pipefail

msg() { [[ -n "${QUTE_FIFO:-}" ]] && printf "message-info '%s'\n" "${1//\'/\'\\\'\'}" >> "$QUTE_FIFO" || true; }
err() { [[ -n "${QUTE_FIFO:-}" ]] && printf "message-error '%s'\n" "${1//\'/\'\\\'\'}" >> "$QUTE_FIFO" || true; }
cmd() { [[ -n "${QUTE_FIFO:-}" ]] && printf '%s\n' "$1" >> "$QUTE_FIFO" || true; }

# ── Mode ──────────────────────────────────────────────────────────────────────
MODE="${1:-}"
case "$MODE" in
  video|mp3) ;;
  "") msg "qute-yt-dl: use  ,dv  (video)  or  ,dm  (MP3)"; exit 0 ;;
  *)  err "qute-yt-dl: unknown mode '$MODE' — use 'video' or 'mp3'"; exit 1 ;;
esac

# ── Which URL? ────────────────────────────────────────────────────────────────
is_video() {
  case "$1" in
    *youtube.com/watch\?*|*youtu.be/*|*youtube.com/shorts/*|*youtube.com/live/*|\
    *music.youtube.com/watch\?*|*vimeo.com/[0-9]*|*twitch.tv/videos/*|\
    *dailymotion.com/video/*) return 0 ;;
    *) return 1 ;;
  esac
}

URL="${2:-}"
if [[ -z "$URL" ]]; then
  if is_video "${QUTE_URL:-}"; then
    URL="$QUTE_URL"                     # single video playing -> use it
  else
    # Not a video page: let the user pick one via qutebrowser hints.
    # (The `ytdl` hints group is registered in config.py.)
    cmd "hint --rapid ytdl spawn --userscript qute-yt-dl $MODE {hint-url}"
    msg "qute-yt-dl: hint a video to download  (Esc to cancel)"
    exit 0
  fi
fi

# ── Dependencies ──────────────────────────────────────────────────────────────
YTDLP="${YTDLP:-$(command -v yt-dlp 2>/dev/null || true)}"
FFMPEG="${FFMPEG:-$(command -v ffmpeg 2>/dev/null || true)}"
if [[ -z "$YTDLP" ]]; then
  err "qute-yt-dl: yt-dlp not found — install with: omarchy pkg add yt-dlp"; exit 1
fi
if [[ "$MODE" == "mp3" && -z "$FFMPEG" ]]; then
  err "qute-yt-dl: ffmpeg not found — install with: omarchy pkg add ffmpeg"; exit 1
fi

# ── Output ────────────────────────────────────────────────────────────────────
DOWNLOAD_DIR="${DOWNLOAD_DIR:-$HOME/Downloads}"
mkdir -p "$DOWNLOAD_DIR"
OUT_TEMPLATE="$DOWNLOAD_DIR/%(title)s.%(ext)s"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-qutebrowser/yt-dl"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/latest.log"          # one stable path: easy to tail, easy to report
PIDFILE="$STATE_DIR/runner.pid"

# SponsorBlock: cut the same segments out of the download (empty = keep them).
# Categories mirror the in-browser defaults in userscripts/youtube-adblock.js.
SPONSOR_CATEGORIES="${SPONSORBLOCK_CATEGORIES:-sponsor,selfpromo,interaction,intro,outro,preview}"
SPONSORBLOCK=()
if [[ -n "$SPONSOR_CATEGORIES" ]] && "$YTDLP" --help 2>/dev/null | grep -q -- "--sponsorblock-remove"; then
  SPONSORBLOCK=(--sponsorblock-remove "$SPONSOR_CATEGORIES")
fi

if [[ "$MODE" == "mp3" ]]; then
  YTDLP_ARGS=(--no-playlist --extract-audio --audio-format mp3 --audio-quality 0
              --embed-thumbnail --embed-metadata "${SPONSORBLOCK[@]}")
else
  # bv*+ba/b is deliberately permissive: the old mp4-only selector failed with
  # "Requested format is not available" on videos offered only as m3u8/webm.
  YTDLP_ARGS=(--no-playlist --format "bv*+ba/b" --merge-output-format mp4
              --embed-thumbnail --embed-metadata "${SPONSORBLOCK[@]}")
fi

# ── Run yt-dlp DETACHED, logging to a file ────────────────────────────────────
# The download must not hang off the terminal window: if the window closed (or was
# never mapped), yt-dlp died with it and nothing landed in ~/Downloads. yt-dlp now
# runs in its own session and writes a live log; the terminal merely *tails* that
# log, so closing it is harmless and a failure stays diagnosable in $LOG.
NOTIFY="$(command -v notify-send 2>/dev/null || true)"
# Emit the notifier as a single-quoted LITERAL assignment, and call it with the message as
# a function ARGUMENT. The previous version hand-glued a whole command line together with
# printf %q and interpolated it unquoted into the runner: unquoted expansion does not
# process backslashes, so the words split anyway, and a stray quote from the hand-glued
# quoting made the generated runner a SYNTAX ERROR — meaning on failure the reporting
# block never ran and a failed download reported nothing at all.
NOTIFY_LITERAL=$(printf "'%s'" "$NOTIFY")

RUNNER="$(mktemp "$STATE_DIR/runner.XXXXXX.sh")"
cat > "$RUNNER" <<RUNNER_EOF
#!/bin/bash
# Detached yt-dlp runner (no set -e: we want the exit status reported, not aborted).
echo \$\$ > "$PIDFILE"
: > "$LOG"
cd "\$HOME" || exit 1
$(printf '%q ' "$YTDLP" --newline "${YTDLP_ARGS[@]}" --output "$OUT_TEMPLATE" -- "$URL")2>&1 | tee -a "$LOG"
rc=\${PIPESTATUS[0]}
NOTIFY_BIN=$NOTIFY_LITERAL
notify() {
  [ -n "\$NOTIFY_BIN" ] || return 0
  "\$NOTIFY_BIN" yt-dlp "\$1" >/dev/null 2>&1 || true
}
{
  echo
  if [ "\$rc" = 0 ]; then
    echo "OK: saved to $DOWNLOAD_DIR"
    notify "Finished — $DOWNLOAD_DIR"
  else
    echo "FAILED (exit \$rc) — full log: $LOG"
    notify "Download failed — see $LOG"
  fi
} >> "$LOG" 2>&1
rm -f "$PIDFILE"
RUNNER_EOF
chmod +x "$RUNNER"

msg "qute-yt-dl: $MODE download started (log: $LOG)"
setsid "$RUNNER" >/dev/null 2>&1 &

# ── The terminal only WATCHES the log (closing it does not stop the download) ──
# foot + Omarchy auto-float for app-id org.omarchy.yt-dl. tail --pid exits on its
# own once the runner is gone, so the window shows the result and can be closed.
WATCH="for i in \$(seq 1 100); do [ -s '$PIDFILE' ] && break; sleep 0.1; done; tail -f --pid=\$(cat '$PIDFILE' 2>/dev/null) -n +1 '$LOG'; echo; echo 'Done — press Enter to close.'; read"
setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.yt-dl --title='yt-dlp' -- \
  bash -c "$WATCH" >/dev/null 2>&1 &
disown || true
