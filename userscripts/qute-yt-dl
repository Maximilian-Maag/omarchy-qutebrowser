#!/bin/bash
# qute-yt-dl — download a video or extract MP3 via yt-dlp
#
# Usage (from qutebrowser config.py):
#   config.bind(",dv", "spawn --userscript qute-yt-dl video", mode="normal")
#   config.bind(",dm", "spawn --userscript qute-yt-dl mp3",   mode="normal")
#
# $1 = "video" (default) or "mp3"
# QUTE_URL = current page URL (set by qutebrowser)
# QUTE_FIFO = path to qutebrowser command FIFO

set -euo pipefail

# ── Helpers ───────────────────────────────────────────────────────────────────
msg() {
  [[ -n "${QUTE_FIFO:-}" ]] && printf "message-info '%s'\n" "${1//\'/\'\\\'\'}" >> "$QUTE_FIFO" || true
}
err() {
  [[ -n "${QUTE_FIFO:-}" ]] && printf "message-error '%s'\n" "${1//\'/\'\\\'\'}" >> "$QUTE_FIFO" || true
}

# ── Validate env ──────────────────────────────────────────────────────────────
URL="${QUTE_URL:-}"
if [[ -z "$URL" ]]; then
  err "qute-yt-dl: QUTE_URL is not set — run this as a qutebrowser userscript"
  exit 1
fi

MODE="${1:-}"
if [[ -z "$MODE" ]]; then
  msg "qute-yt-dl: use  ,dv  to download video  or  ,dm  for MP3"
  exit 0
fi

if [[ "$MODE" != "video" && "$MODE" != "mp3" ]]; then
  err "qute-yt-dl: unknown mode '$MODE' — use 'video' or 'mp3'"
  exit 1
fi

# ── Dependencies ──────────────────────────────────────────────────────────────
YTDLP="${YTDLP:-$(command -v yt-dlp 2>/dev/null)}"
FFMPEG="${FFMPEG:-$(command -v ffmpeg 2>/dev/null)}"

if [[ -z "$YTDLP" ]]; then
  err "qute-yt-dl: yt-dlp not found — install with: omarchy pkg add yt-dlp"
  exit 1
fi
if [[ "$MODE" == "mp3" && -z "$FFMPEG" ]]; then
  err "qute-yt-dl: ffmpeg not found — install with: omarchy pkg add ffmpeg"
  exit 1
fi

# ── Output directory ──────────────────────────────────────────────────────────
DOWNLOAD_DIR="${DOWNLOAD_DIR:-$HOME/Downloads}"
mkdir -p "$DOWNLOAD_DIR"

# ── Build yt-dlp command string (safely shell-quoted) ─────────────────────────
# printf %q escapes each argument so the resulting string is safe to eval in
# the bash -c payload even when paths or the URL contain spaces/special chars.
OUT_TEMPLATE="$DOWNLOAD_DIR/%(title)s.%(ext)s"

if [[ "$MODE" == "mp3" ]]; then
  msg "qute-yt-dl: extracting MP3 from $URL …"
  YTDLP_CMD=$(printf '%q ' \
    "$YTDLP" \
    --extract-audio \
    --audio-format mp3 \
    --audio-quality 0 \
    --embed-thumbnail \
    --add-metadata \
    --output "$OUT_TEMPLATE" \
    -- "$URL")
else
  msg "qute-yt-dl: downloading video from $URL …"
  YTDLP_CMD=$(printf '%q ' \
    "$YTDLP" \
    --format "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
    --merge-output-format mp4 \
    --embed-thumbnail \
    --add-metadata \
    --output "$OUT_TEMPLATE" \
    -- "$URL")
fi

# ── Launch floating terminal with live yt-dlp output ─────────────────────────
# xdg-terminal-exec launches foot; Omarchy's Hyprland config auto-floats
# windows whose app-id matches org.omarchy.yt-dl.
# setsid + disown ensure qutebrowser is not blocked.
setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.yt-dl --title='yt-dlp' -- \
  bash -c "$YTDLP_CMD; echo; echo 'Done. Press Enter to close.'; read" &
disown
