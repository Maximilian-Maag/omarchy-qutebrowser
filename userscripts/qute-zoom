#!/usr/bin/env python3
"""qute-zoom — persist per-domain zoom levels for qutebrowser.

Usage (bind in qutebrowser config):
  :spawn --userscript qute-zoom          # save current zoom for this domain
  :spawn --userscript qute-zoom load     # restore saved zoom for this domain
  :spawn --userscript qute-zoom reset    # remove saved zoom, restore 1.0
"""

import json
import os
import sys
from pathlib import Path
from urllib.parse import urlparse

# ── Environment ──────────────────────────────────────────────────────────────

QUTE_URL  = os.environ.get("QUTE_URL", "")
QUTE_FIFO = os.environ.get("QUTE_FIFO", "")
QUTE_ZOOM = os.environ.get("QUTE_ZOOM", "1.0")

if not QUTE_FIFO:
    sys.exit("QUTE_FIFO not set")

# ── Helpers ───────────────────────────────────────────────────────────────────

_state_home = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
ZOOM_FILE = Path(_state_home) / "omarchy-qutebrowser" / "zoom.json"


def fifo_cmd(command: str) -> None:
    with open(QUTE_FIFO, "w") as f:
        f.write(command + "\n")


def msg_info(text: str) -> None:
    # Escape single quotes to avoid breaking the qutebrowser command parser
    fifo_cmd(f"message-info '{text.replace(chr(39), chr(39) + chr(92) + chr(39) + chr(39))}'")


def get_domain(url: str) -> str:
    parsed = urlparse(url)
    return parsed.netloc or parsed.path  # fallback for unusual schemes


def load_zoom_db() -> dict:
    if ZOOM_FILE.exists():
        try:
            return json.loads(ZOOM_FILE.read_text())
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


def save_zoom_db(db: dict) -> None:
    ZOOM_FILE.parent.mkdir(parents=True, exist_ok=True)
    ZOOM_FILE.write_text(json.dumps(db, indent=2, sort_keys=True))


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_save() -> None:
    """Save current zoom level for the current domain."""
    domain = get_domain(QUTE_URL)
    if not domain:
        msg_info("qute-zoom: cannot determine domain from URL")
        return
    try:
        zoom = float(QUTE_ZOOM)
    except ValueError:
        msg_info(f"qute-zoom: invalid zoom value '{QUTE_ZOOM}'")
        return
    db = load_zoom_db()
    db[domain] = zoom
    save_zoom_db(db)
    msg_info(f"qute-zoom: saved {zoom:.0%} for {domain}")


def cmd_load() -> None:
    """Restore saved zoom level for the current domain."""
    domain = get_domain(QUTE_URL)
    if not domain:
        msg_info("qute-zoom: cannot determine domain from URL")
        return
    db = load_zoom_db()
    if domain not in db:
        msg_info(f"qute-zoom: no saved zoom for {domain}")
        return
    zoom = db[domain]
    fifo_cmd(f"zoom {zoom}")
    msg_info(f"qute-zoom: restored {zoom:.0%} for {domain}")


def cmd_reset() -> None:
    """Remove saved zoom for the current domain and reset to 1.0."""
    domain = get_domain(QUTE_URL)
    if not domain:
        msg_info("qute-zoom: cannot determine domain from URL")
        return
    db = load_zoom_db()
    removed = db.pop(domain, None)
    save_zoom_db(db)
    fifo_cmd("zoom 1.0")
    if removed is not None:
        msg_info(f"qute-zoom: reset zoom for {domain} (was {removed:.0%})")
    else:
        msg_info(f"qute-zoom: no saved zoom for {domain}, reset to 100%")


# ── Entry point ───────────────────────────────────────────────────────────────

COMMANDS = {
    "load":  cmd_load,
    "reset": cmd_reset,
}

if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    COMMANDS.get(arg, cmd_save)()
