#!/usr/bin/env python3
"""omarchy-qutebrowser reader-server — localhost bridge for the distraction-free reader.

A tiny HTTP server bound to 127.0.0.1 that:

  * serves the reader page (reader/index.html + reader.css + reader.js +
    readability.js) for a page the qute-reader userscript ingested, and
  * exposes POST /ai, which runs the *local* AI agent (`hermes -z … --cli`) and
    returns JSON, so the reader page can mark paragraphs / the whole article as
    possibly AI-written and generate a summary.

Security: bound to loopback only, and every /reader + /ai request must carry the
per-session token written to server.json. Article HTML lives under the state dir.

Started on demand by userscripts/qute-reader; writes server.json and stays up.
"""

import hashlib
import html
import json
import os
import pathlib
import re
import secrets
import subprocess
import sys
import threading
import time
import urllib.request
import xml.etree.ElementTree as ET
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs, quote_plus

PLUGIN_DIR = pathlib.Path(__file__).resolve().parent.parent
READER_DIR = PLUGIN_DIR / "reader"
STATUS_DIR = PLUGIN_DIR / "status"
PUBLISHERS_FILE = PLUGIN_DIR / "data" / "publishers.json"
STATE_DIR = pathlib.Path(
    os.environ.get("XDG_STATE_HOME") or (pathlib.Path.home() / ".local/state")
) / "omarchy-qutebrowser" / "reader"
ARTICLES_DIR = STATE_DIR / "articles"
STATE_STORE = STATE_DIR / "article-state"      # per-URL annotations + reading position
SERVER_JSON = STATE_DIR / "server.json"
# Identity of the running CODE, not just the process: a server started before an
# update keeps serving the old routes forever, which looked exactly like "the status
# page does not render" (every /status request 404s). The userscript compares this
# to the file on disk and replaces a stale server.
BUILD = hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()[:12]


def _state_key(url):
    """Stable key for an article's saved state.

    The reader's article ids are regenerated on every ingest, so annotations are
    keyed by the article URL instead — reopening the same URL restores them.
    """
    return hashlib.sha1(url.encode("utf-8", "replace")).hexdigest()[:16]


def _state_path(url):
    return STATE_STORE / ("%s.json" % _state_key(url))


def _write_state(url, state):
    """Atomically persist one article's annotations (0600)."""
    path = _state_path(url)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(json.dumps({"url": url, "saved": time.time(), **state}))
    os.replace(tmp, path)

HERMES = os.environ.get("QUTE_READER_AI", "hermes")
AI_TIMEOUT = int(os.environ.get("QUTE_READER_AI_TIMEOUT", "180"))
NEWS_TIMEOUT = int(os.environ.get("QUTE_READER_NEWS_TIMEOUT", "15"))
NEWS_UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
           "(KHTML, like Gecko) Chrome/124 Safari/537.36")
_AI_SLOTS = threading.BoundedSemaphore(2)


# --------------------------------------------------------------------------- #
# Theme colours (so the reader matches the active Omarchy theme)
# --------------------------------------------------------------------------- #
def theme_colors():
    fallback = {"mode": "dark", "bg": "#0B0C16", "fg": "#ddf7ff",
                "bg_dark": "#080910", "bg_light": "#161b22",
                "fg_dim": "#6a6e95", "accent": "#82FB9C", "selection": "#1f253a",
                "red": "#ff5555", "green": "#82FB9C", "yellow": "#f1fa8c"}
    try:
        name = (STATE_DIR.parent / "active-theme").read_text().strip()
    except OSError:
        return fallback
    if not name:
        return fallback
    for base in (pathlib.Path.home() / ".config/omarchy/themes",
                 pathlib.Path("/usr/share/omarchy/themes")):
        colors = base / name / "colors.toml"
        if colors.exists():
            try:
                import tomllib
                raw = tomllib.loads(colors.read_text())
                return {
                    "mode": raw.get("mode", "dark"),
                    "bg": raw.get("background", fallback["bg"]),
                    "fg": raw.get("foreground", fallback["fg"]),
                    "bg_dark": raw.get("dark_background", fallback["bg_dark"]),
                    "bg_light": raw.get("lighter_background", fallback["bg_light"]),
                    "fg_dim": raw.get("dark_foreground", fallback["fg_dim"]),
                    "accent": raw.get("accent", fallback["accent"]),
                    "selection": raw.get("selection", fallback["selection"]),
                    "red": raw.get("red", "#ff5555"),
                    "green": raw.get("green", "#82FB9C"),
                    "yellow": raw.get("yellow", "#f1fa8c"),
                }
            except Exception:
                return fallback
    return fallback


# --------------------------------------------------------------------------- #
# Local AI
# --------------------------------------------------------------------------- #
PARA_PROMPT = """You are a text-provenance analyst. Judge whether the passage below was written by an AI (LLM) or a human.
Return ONLY compact JSON, no markdown:
{"ai_likelihood": <int 0-100>, "verdict": "human"|"mixed"|"ai", "reason": "<max 15 words>"}

Passage:
%s"""

ARTICLE_PROMPT = """You are a text-provenance analyst. Below are numbered paragraphs from one article.
For EACH paragraph estimate how likely it was written by an AI (LLM) rather than a human.
Return ONLY a JSON array, one object per paragraph, in the same order, no markdown:
[{"index": <int>, "ai_likelihood": <int 0-100>, "verdict": "human"|"mixed"|"ai", "reason": "<max 12 words>"}]

Paragraphs:
%s"""

# Combined: AI-ness per paragraph AND an overall summary in one call.
SUMMARY_PROMPT = """Summarize the article below for a reader who wants the gist, and judge two things about it: whether it reads as machine-written, and whether it reads as paid or promotional content rather than independent journalism.

Return ONLY compact JSON, no markdown:
{"summary": ["<short bullet>", "<short bullet>", "..."], "ai_likelihood": <int 0-100>, "verdict": "human"|"mixed"|"ai", "reason": "<max 15 words>", "promotional": {"score": <int 0-100>, "kind": "<advertorial|sponsored|native ad|affiliate|PR|brand content|none>", "evidence": "<max 25 words>"}}

The "promotional" score says how strongly the article looks like an advertorial, a sponsored/native ad, a press release or an affiliate piece rather than independent reporting. Judge it from concrete signals, for example:
- a disclosure label: sponsored, advertisement, advertorial, "in cooperation with", "Anzeige", "Werbung", "bezahlte Anzeige"/"bezahlter Beitrag", "in Zusammenarbeit mit", "ADVERTORIAL";
- the piece promotes one brand, company or product throughout, with rivals absent or dismissed;
- vendor voice: "we"/"our product"/"unser Produkt" while posing as editorial, testimonials, or a "test" that is really a sales pitch;
- prices, discounts, referral/affiliate links, or a strong call to action ("jetzt kaufen", "buy now", "sign up today");
- superlatives and unverifiable claims with no sourcing, no byline, no critical or opposing quotes;
- the subject has a commercial sender (a press release, a product launch, an event promotion).

Score 0-20 for ordinary independent reporting; 40-60 when there are clear commercial signals but it may still be legitimate; 70-100 when it is probably paid or promotional content. Use kind "none" below 40. "evidence" must quote or point at the concrete signal (a label, a phrase, a link), not a general impression — and do not infer anything from the outlet's name alone. Never let this judgement change the summary itself.

Article:
%s"""

# Fact-check: compare one paragraph against recent headlines from other outlets.
FACT_PROMPT = """You are a fact-checking analyst. A reader wants to know whether the passage below is corroborated, or contradicted, by other news outlets.
Under the passage are recent headlines from other outlets (found by searching the passage's key terms).

Return ONLY compact JSON, no markdown:
{"verdict": "supported"|"disputed"|"unclear"|"opinion", "confidence": <int 0-100>, "reason": "<max 25 words>"}

Use "supported" when several independent outlets report the same thing, "disputed" when they contradict it or frame it very differently, "unclear" when the headlines are unrelated or not enough, and "opinion" when the passage is opinion/analysis rather than a checkable fact.

Passage:
%s

Headlines from other outlets:
%s"""

# Whole-article fact-check: many passages, one call.
FACT_ARTICLE_PROMPT = """You are a fact-checking analyst. Below are numbered passages from one article; under each are recent headlines from other outlets found for that passage.
For EACH passage decide whether other outlets corroborate it ("supported"), contradict it ("disputed"), the headlines are unrelated/insufficient ("unclear"), or the passage is opinion/analysis ("opinion").
Return ONLY a JSON array, one object per passage, in the same order, no markdown:
[{"index": <int>, "verdict": "supported"|"disputed"|"unclear"|"opinion", "confidence": <int 0-100>, "reason": "<max 20 words>"}]

Passages:
%s"""

# Summarise one paragraph.
PARA_SUMMARY_PROMPT = """Summarise the single passage below in exactly ONE short sentence, in the same language as the passage. Say what it claims or states, not how it is written. Do not add a second sentence.
Return ONLY compact JSON, no markdown:
{"summary": ["<one sentence>"], "reason": "<max 12 words>"}

Passage:
%s"""


def extract_json(text):
    """Pull the JSON object/array out of an LLM response.

    Tries the whole string first, then parses from the EARLIEST opening bracket
    (so `{"summary": [...]}` yields the object, not the inner array)."""
    text = text.strip()
    text = re.sub(r"^```[a-zA-Z]*\s*|```$", "", text, flags=re.M).strip()
    try:
        return json.loads(text)
    except ValueError:
        pass
    starts = [(text.find(c), c) for c in "[{" if text.find(c) != -1]
    for pos, opener in sorted(starts):
        closer = "]" if opener == "[" else "}"
        end = text.rfind(closer)
        if end > pos:
            try:
                return json.loads(text[pos:end + 1])
            except ValueError:
                continue
    raise ValueError("no JSON found in model output")


def run_ai(prompt, timeout=None):
    # Each call spawns a local agent process; a handful can be started at once
    # (per-paragraph score + whole-article mark + summary), so bound concurrency
    # instead of letting them pile up.
    with _AI_SLOTS:
        proc = subprocess.run([HERMES, "-z", prompt, "--cli"],
                              capture_output=True, text=True, timeout=timeout or AI_TIMEOUT)
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or "hermes failed").strip()[:300])
    return extract_json(proc.stdout)


# --------------------------------------------------------------------------- #
# News search (Google News RSS) — the "other news outlets" for fact-checking
# --------------------------------------------------------------------------- #
_STOP = set("""
der die das den dem des ein eine einen einem eines und oder aber auch nicht nur noch sich sowie beim durch
für fuer ueber über unter zwischen nach vor bei aus mit von zum zur im in an auf ist sind war waren wird werden
dass dieser diese dieses als aus kann man mehr sehr
the a an and or but of to in on for with as at by from is are was were be been being this that these those
it its has have had will would can could should may might not no more most very than then when where which who
""".split())


def news_query(text):
    """Build a short search query from a paragraph (distinctive words only)."""
    words = re.findall(r"[0-9A-Za-zÄÖÜäöüß][0-9A-Za-zÄÖÜäöüß.\-]{3,}", text or "")
    out, seen = [], set()
    for w in words:
        lw = w.lower()
        if lw in _STOP or lw in seen:
            continue
        seen.add(lw)
        out.append(w)
        if len(out) >= 8:
            break
    return " ".join(out)


def news_search(query, lang):
    hl, gl, ceid = {"en": ("en-US", "US", "US:en"),
                    "de": ("de", "DE", "DE:de")}[lang]
    url = ("%s/rss/search?q=%s&hl=%s&gl=%s&ceid=%s"
           % (_NEWS_BASE, quote_plus(query), hl, gl, ceid))
    req = urllib.request.Request(url, headers={"User-Agent": NEWS_UA})
    with urllib.request.urlopen(req, timeout=NEWS_TIMEOUT) as resp:
        data = resp.read()
    try:
        root = ET.fromstring(data)
    except ET.ParseError:
        return []
    hits = []
    for item in root.iter("item"):
        title = (item.findtext("title") or "").strip()
        link = (item.findtext("link") or "").strip()
        src_el = item.find("source")
        source = (src_el.text or "").strip() if src_el is not None and src_el.text else ""
        headline = title
        if source and title.endswith(" - " + source):
            headline = title[: -len(" - " + source)]
        elif not source and " - " in title:
            headline, source = title.rsplit(" - ", 1)
        if headline:
            hits.append({"headline": headline, "source": source, "url": link})
    return hits


def fact_check(para, query=None):
    """Search news outlets for the paragraph and ask the local model to compare."""
    query = query or news_query(para)
    hits, seen = [], set()
    for lang in ("de", "en"):
        try:
            found = news_search(query, lang)
        except Exception:  # noqa: BLE001 - network/parse issues are non-fatal
            found = []
        for h in found:
            key = h["headline"].lower()
            if key in seen:
                continue
            seen.add(key)
            hits.append(h)
    lines = "\n".join("- %s (%s)" % (h["headline"], h["source"] or "?")
                      for h in hits[:15]) or "(no recent headlines found)"
    result = run_ai(FACT_PROMPT % (para, lines))
    if isinstance(result, dict):
        result["query"] = query
        result["headlines"] = hits[:8]
        result["outlets"] = sorted({h["source"] for h in hits if h["source"]})[:12]
    return result


def _headlines_for(text, cache):
    """Search news for one passage, memoised on the query."""
    query = news_query(text)
    if query in cache:
        return cache[query]
    hits, seen = [], set()
    for lang in ("de", "en"):
        try:
            found = news_search(query, lang)
        except Exception:  # noqa: BLE001
            found = []
        for h in found:
            key = h["headline"].lower()
            if key in seen:
                continue
            seen.add(key)
            hits.append(h)
    cache[query] = (query, hits)
    return cache[query]


MAX_PROMPT_CHARS = 96000          # safely under Linux's ~128 KiB single-argv limit


def _paragraph_batches(paras, budget=48000):
    """Yield [(index, paragraph)] batches whose joined prompt stays under `budget`."""
    cur, size = [], 0
    for i, p in enumerate(paras):
        piece = len(p or "") + 12
        if cur and size + piece > budget:
            yield cur
            cur, size = [], 0
        cur.append((i, p or ""))
        size += piece
    if cur:
        yield cur


def fact_check_article(paras, min_len=20, batch_size=8):
    """Fact-check EVERY paragraph, in batches.

    Two bugs lived here. A hard `max_paras=12` silently left the rest of the article
    unchecked, and asking one prompt to cover a whole article made the model drop
    entries — so "fact-check the article" checked an unpredictable subset. Now every
    paragraph at or above min_len is checked, in batches small enough that the model
    answers for all of them, and any paragraph the model still skips comes back with a
    note instead of vanishing.
    """
    cache, picked = {}, []
    for i, p in enumerate(paras):
        text = (p or "").strip()
        if len(text) < min_len:          # skip headings / one-word fragments
            continue
        query, hits = _headlines_for(text, cache)
        picked.append({"index": i, "text": text, "query": query, "headlines": hits[:6]})
    if not picked:
        raise ValueError("no checkable paragraphs")

    out = []
    for start_at in range(0, len(picked), batch_size):
        batch = picked[start_at:start_at + batch_size]
        listing = "\n".join(
            "%d. %s\n   Headlines: %s" % (
                b["index"], b["text"][:600],
                "; ".join("%s (%s)" % (h["headline"], h["source"] or "?")
                          for h in b["headlines"]) or "(none)")
            for b in batch)
        arr = run_ai(FACT_ARTICLE_PROMPT % listing)
        by_index = {b["index"]: b for b in batch}
        answered = set()
        for j, item in enumerate(arr if isinstance(arr, list) else []):
            if not isinstance(item, dict):
                continue
            idx = item.get("index")
            if not isinstance(idx, int) or idx not in by_index:
                idx = batch[j]["index"] if j < len(batch) else None
            if idx is None or idx not in by_index:
                continue
            src = by_index[idx]
            merged = dict(item)
            merged["index"] = idx
            merged["query"] = src["query"]
            merged["headlines"] = src["headlines"]
            merged["outlets"] = sorted({h["source"] for h in src["headlines"] if h["source"]})[:12]
            out.append(merged)
            answered.add(idx)
        for b in batch:                  # never drop a paragraph silently
            if b["index"] in answered:
                continue
            out.append({"index": b["index"], "verdict": "unclear",
                        "note": "the model returned no verdict for this paragraph",
                        "query": b["query"], "headlines": b["headlines"],
                        "outlets": sorted({h["source"] for h in b["headlines"] if h["source"]})[:12]})
    out.sort(key=lambda item: item["index"])
    return out


def ai_answer(payload):
    mode = payload.get("mode")
    if mode == "paragraph":
        para = (payload.get("text") or "").strip()
        if not para:
            raise ValueError("empty paragraph")
        return run_ai(PARA_PROMPT % para)
    if mode == "article_marks":
        paras = payload.get("paragraphs") or []
        if not paras:
            raise ValueError("no paragraphs")
        # Batched by SIZE, not by count. The prompt goes to the model as a command-line
        # argument, and Linux caps one argv string at ~128 KiB (MAX_ARG_STRLEN), so a
        # long article made this mode fail with E2BIG and nothing got scored at all.
        # Results carry an explicit GLOBAL index so the client cannot mis-attribute them
        # positionally, and the batch order is preserved.
        out = []
        for batch in _paragraph_batches(paras):
            numbered = "\n".join("%d. %s" % (i, p) for i, p in batch)
            arr = run_ai(ARTICLE_PROMPT % numbered)
            if not isinstance(arr, list):
                continue
            span = (batch[0][0], batch[-1][0])
            for j, item in enumerate(arr):
                if not isinstance(item, dict):
                    continue
                item = dict(item)
                idx = item.get("index")
                if not (isinstance(idx, int) and span[0] <= idx <= span[1]):
                    idx = batch[j][0] if j < len(batch) else None
                if idx is None:
                    continue
                item["index"] = idx
                out.append(item)
        return sorted(out, key=lambda it: it["index"])
    if mode == "summary":
        text = (payload.get("text") or "").strip()
        if not text:
            raise ValueError("empty article")
        # keep the prompt payload sane
        return run_ai(SUMMARY_PROMPT % text[:20000])
    if mode == "factcheck":
        para = (payload.get("text") or "").strip()
        if not para:
            raise ValueError("empty paragraph")
        return fact_check(para, payload.get("query"))
    if mode == "factcheck_article":
        paras = payload.get("paragraphs") or []
        if not paras:
            raise ValueError("no paragraphs")
        return fact_check_article(paras)
    if mode == "summary_para":
        para = (payload.get("text") or "").strip()
        if not para:
            raise ValueError("empty paragraph")
        return run_ai(PARA_SUMMARY_PROMPT % para[:8000])
    raise ValueError("unknown mode %r" % mode)


# --------------------------------------------------------------------------- #
# Publisher profiles, cross-outlet coverage, citation metadata (status page)
# --------------------------------------------------------------------------- #
_NEWS_BASE = os.environ.get("QUTE_STATUS_NEWS_BASE", "https://news.google.com")
_WIKI_BASE = os.environ.get("QUTE_STATUS_WIKI_BASE", "https://en.wikipedia.org")
_PUBS = {}


def publishers():
    if not _PUBS:
        try:
            _PUBS.update(json.loads(PUBLISHERS_FILE.read_text()))
        except (OSError, ValueError):
            _PUBS.update({"publishers": [], "agencies": []})
    return _PUBS


def normalize_host(value):
    host = (value or "").strip().lower()
    if "//" in host:
        host = host.split("//", 1)[1]
    host = host.split("/", 1)[0].split("?", 1)[0]
    if "@" in host:
        host = host.split("@", 1)[1]
    if ":" in host:
        host = host.split(":", 1)[0]
    return host[4:] if host.startswith("www.") else host


def publisher_for(url_or_host, name=None):
    """Look a host, or an outlet name from a headline, up in the dataset."""
    host = normalize_host(url_or_host)
    entries = publishers().get("publishers", [])
    best = None
    for e in entries:
        dom = normalize_host(e.get("domain", ""))
        if host and dom and (host == dom or host.endswith("." + dom)):
            if best is None or len(dom) > len(normalize_host(best.get("domain", ""))):
                best = e                       # longest match wins (amp./m. subdomains)
    if best:
        return best
    want = (name or "").strip().lower()
    if not want:
        return None
    for e in entries:
        for cand in (e.get("name", ""), e.get("domain", "").split(".")[0]):
            cand = (cand or "").strip().lower()
            if not cand:
                continue
            # Word-boundary match, never a bare substring. The second candidate is the
            # domain's FIRST LABEL, which is often two letters — "rt" for rt.com — and
            # `cand in want` matched that inside unrelated names, so "Auto Motor und
            # Sport" was labelled RT/state/low and "SPEEDWEEK.com" became Deutsche Welle.
            # Whole words still match where they should ("CNN" in "CNN Türk").
            if cand == want or re.search(r"\b" + re.escape(cand) + r"\b", want):
                return e
    return None


def wiki_summary(name):
    """Best-effort encyclopaedia summary for a publisher; never fatal."""
    if not name:
        return None
    url = "%s/api/rest_v1/page/summary/%s" % (_WIKI_BASE.rstrip("/"), quote_plus(name.replace(" ", "_")))
    try:
        req = urllib.request.Request(url, headers={"User-Agent": NEWS_UA})
        with urllib.request.urlopen(req, timeout=NEWS_TIMEOUT) as resp:
            data = json.loads(resp.read())
    except Exception:  # noqa: BLE001 - enrichment only
        return None
    return {"title": data.get("title", ""),
            "extract": (data.get("extract") or "").strip()[:700],
            "url": ((data.get("content_urls") or {}).get("desktop") or {}).get("page", "")}


LEAN_ORDER = ["left", "lean-left", "center", "lean-right", "right"]


def coverage_for(title, url=""):
    """Other outlets running the same story, tagged with the dataset's lean."""
    query = news_query(title or "")
    if not query:
        return {"query": "", "outlets": [], "balance": {}, "total": 0}
    hits, seen = [], set()
    for lang in ("de", "en"):
        try:
            found = news_search(query, lang)
        except Exception:  # noqa: BLE001 - network issues are non-fatal
            found = []
        for h in found:
            key = (h.get("headline") or "").lower()
            if not key or key in seen:
                continue
            seen.add(key)
            hits.append(h)
    own = normalize_host(url)
    balance = {k: 0 for k in LEAN_ORDER + ["unknown"]}
    outlets, seen_src = [], set()
    for h in hits:
        src = (h.get("source") or "").strip() or "(unknown outlet)"
        if src.lower() in seen_src:
            continue
        prof = publisher_for("", src)
        dom = normalize_host((prof or {}).get("domain", ""))
        if own and dom and dom == own:
            continue                           # the article's own outlet
        seen_src.add(src.lower())
        lean = (prof or {}).get("lean") or "unknown"
        balance[lean if lean in balance else "unknown"] += 1
        outlets.append({"name": src, "headline": h.get("headline", ""), "url": h.get("url", ""),
                        "lean": lean, "factual": (prof or {}).get("factual") or "",
                        "known": bool(prof)})
        if len(outlets) >= 24:
            break
    return {"query": query, "outlets": outlets, "balance": balance,
            "balance_order": LEAN_ORDER, "total": len(outlets)}


def citation_from_html(html_text, meta):
    """Author, date, publisher, canonical URL — everything needed to cite."""
    def meta_content(*names):
        for name in names:
            m = re.search(r"<meta[^>]+(?:name|property|itemprop)=[\"']%s[\"'][^>]*>" % re.escape(name),
                          html_text, re.I)
            if not m:
                continue
            c = re.search(r"content=[\"]([^\"]*)[\"]", m.group(0), re.I)
            if c and c.group(1).strip():
                return html.unescape(c.group(1).strip())
        return ""

    ld = {}
    for m in re.finditer(r"<script[^>]+application/ld\+json[^>]*>(.*?)</script>",
                         html_text, re.I | re.S):
        try:
            data = json.loads(m.group(1).strip())
        except ValueError:
            continue
        for item in (data if isinstance(data, list) else [data]):
            if isinstance(item, dict) and str(item.get("@type", "")).lower() in (
                    "newsarticle", "article", "reportagenewsarticle", "blogposting"):
                ld = item
                break
        if ld:
            break

    def names(value):
        out = []
        for v in (value if isinstance(value, list) else [value]):
            if isinstance(v, dict) and v.get("name"):
                out.append(str(v["name"]).strip())
            elif isinstance(v, str) and v.strip():
                out.append(v.strip())
        return out

    authors = names(ld.get("author")) or [meta_content("author", "byl", "sailthru.author",
                                                       "article:author")]
    publisher = names(ld.get("publisher")) or [meta_content("og:site_name", "publisher",
                                                            "application-name", "twitter:site")]
    canonical = meta_content("og:url") or ""
    if not canonical:
        m = re.search(r"<link[^>]+rel=[\"']canonical[\"'][^>]*href=[\"']([^\"']+)[\"']", html_text, re.I)
        if m:
            canonical = html.unescape(m.group(1).strip())
    url = (meta.get("url") or "").strip() or canonical
    return {"title": (ld.get("headline") or meta_content("og:title", "twitter:title")
                      or meta.get("title", "")).strip(),
            "authors": [a for a in authors if a][:4],
            "publisher": (publisher[0] if publisher else "") or normalize_host(url),
            "date": str(ld.get("datePublished") or meta_content(
                "article:published_time", "datePublished", "pubdate", "date", "og:published_time") or "").strip(),
            "url": url, "canonical": canonical or url,
            "site": meta_content("og:site_name") or normalize_host(url),
            "lang": meta_content("og:locale") or ""}


FRAMING_PROMPT = """You analyse how a news article is framed. Reply with ONLY JSON:
{"tone": "neutral|alarmist|promotional|opinionated|matter-of-fact",
 "framing": "one or two sentences: what the headline stresses, whose voice leads, what angle the piece takes",
 "loaded_terms": ["up to 8 words or short phrases that carry the framing"],
 "omissions": "one sentence on what a reader does not learn from this piece",
 "claim": "the article's single main claim, one sentence",
 "confidence": "high|medium|low"}
Title: %s

Text: %s"""


# --------------------------------------------------------------------------- #
# HTTP
# --------------------------------------------------------------------------- #
class Handler(BaseHTTPRequestHandler):
    server_version = "omarchyReader/1.0"
    token = None

    def log_message(self, *a):  # silence
        pass

    # -- helpers --
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            data = json.dumps(body).encode()
        elif isinstance(body, bytes):
            data = body
        else:
            data = str(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _authed(self, query):
        return query.get("t", [""])[0] == self.token

    def _asset(self, name, ctype, base=None):
        root = (base or READER_DIR).resolve()
        path = (root / name).resolve()
        if not path.is_relative_to(root) or not path.is_file():
            return self._send(404, "not found", "text/plain")
        return self._send(200, path.read_bytes(), ctype)

    def _article(self, article_id):
        """The stored page for an id, or None (ids are server-generated only)."""
        if not re.fullmatch(r"[0-9a-f]{16}", article_id or ""):
            return None
        meta_path = ARTICLES_DIR / ("%s.json" % article_id)
        html_path = ARTICLES_DIR / ("%s.html" % article_id)
        if not meta_path.exists() or not html_path.exists():
            return None
        try:
            meta = json.loads(meta_path.read_text())
        except (OSError, ValueError):
            return None
        return meta, html_path.read_text(errors="replace")

    def _status_page(self, article_id):
        found = self._article(article_id)
        if not found:
            return self._send(404, "article not found", "text/plain")
        meta, article_html = found
        template = (STATUS_DIR / "index.html").read_text()

        def jdump(obj):
            return json.dumps(obj).replace("</", "<\\/")
        cite = citation_from_html(article_html, meta)
        page = (template
                .replace("__TOKEN__", self.token)
                .replace("__TITLE__", html.escape(meta.get("title", ""), quote=True))
                .replace("__URL__", html.escape(meta.get("url", ""), quote=True))
                .replace("__COLORS__", jdump(theme_colors()))
                .replace("__CITE_JSON__", jdump(cite))
                .replace("__ARTICLE_JSON__", jdump(article_html)))
        return self._send(200, page, "text/html; charset=utf-8")

    def _reader_page(self, article_id):
        # Only accept ids this server's companion userscript generates; never let a
        # request name an arbitrary path.
        if not re.fullmatch(r"[0-9a-f]{16}", article_id or ""):
            return self._send(404, "article not found", "text/plain")
        meta_path = ARTICLES_DIR / ("%s.json" % article_id)
        html_path = ARTICLES_DIR / ("%s.html" % article_id)
        if not meta_path.exists() or not html_path.exists():
            return self._send(404, "article not found", "text/plain")
        meta = json.loads(meta_path.read_text())
        article_html = html_path.read_text(errors="replace")
        template = (READER_DIR / "index.html").read_text()
        # JSON embedded in <script>: escape "</" so "</script>" in the article
        # cannot break out of the element.
        def jdump(obj):
            return json.dumps(obj).replace("</", "<\\/")
        page = (template
                .replace("__TOKEN__", self.token)
                .replace("__TITLE__", html.escape(meta.get("title", ""), quote=True))
                .replace("__URL__", html.escape(meta.get("url", ""), quote=True))
                .replace("__COLORS__", jdump(theme_colors()))
                .replace("__ARTICLE_JSON__", jdump(article_html)))
        return self._send(200, page, "text/html; charset=utf-8")

    # -- routes --
    def do_GET(self):
        url = urlparse(self.path)
        q = parse_qs(url.query)
        p = url.path
        if p == "/health":
            return self._send(200, {"ok": True, "build": BUILD})
        if p in ("/readability.js", "/reader.css", "/reader.js"):
            ctype = "application/javascript" if p.endswith(".js") else "text/css"
            return self._asset(p.lstrip("/"), ctype)
        if p.startswith("/reader/"):
            if not self._authed(q):
                return self._send(403, {"error": "bad token"})
            return self._reader_page(p.split("/")[-1])
        if p in ("/status.css", "/status.js"):
            ctype = "application/javascript" if p.endswith(".js") else "text/css"
            return self._asset(p.lstrip("/"), ctype, STATUS_DIR)
        if p.startswith("/status/"):
            if not self._authed(q):
                return self._send(403, {"error": "bad token"})
            return self._status_page(p.split("/")[-1])
        if p == "/publisher":
            if not self._authed(q):
                return self._send(403, {"error": "bad token"})
            name = (q.get("name") or [""])[0]
            profile = publisher_for((q.get("domain") or q.get("url") or [""])[0], name) or {}
            return self._send(200, {"profile": profile,
                                    "wikipedia": wiki_summary(profile.get("name") or name),
                                    "agencies": publishers().get("agencies", [])})
        if p == "/coverage":
            if not self._authed(q):
                return self._send(403, {"error": "bad token"})
            return self._send(200, coverage_for((q.get("title") or [""])[0],
                                                (q.get("url") or [""])[0]))
        if p == "/state":
            # Saved annotations + reading position for one article URL.
            if not self._authed(q):
                return self._send(403, {"error": "bad token"})
            url = (q.get("url") or [""])[0].strip()
            if not url:
                return self._send(400, {"error": "missing url"})
            path = _state_path(url)
            if not path.is_file():
                return self._send(200, {})
            try:
                return self._send(200, json.loads(path.read_text()))
            except (OSError, ValueError):
                return self._send(200, {})
        return self._send(404, {"error": "not found"})

    def do_POST(self):
        parsed = urlparse(self.path)
        q = parse_qs(parsed.query)
        if not self._authed(q):
            return self._send(403, {"error": "bad token"})
        if parsed.path not in ("/ai", "/state", "/framing"):
            return self._send(404, {"error": "not found"})
        try:
            length = int(self.headers.get("Content-Length", 0))
            if length > 4 * 1024 * 1024:
                return self._send(413, {"ok": False, "error": "payload too large"})
            payload = json.loads(self.rfile.read(length) or b"{}")
        except Exception as exc:  # noqa: BLE001
            return self._send(400, {"ok": False, "error": str(exc)})
        if parsed.path == "/framing":
            title = str(payload.get("title") or "").strip()[:300]
            text = str(payload.get("text") or "").strip()[:8000]
            if not text:
                return self._send(400, {"ok": False, "error": "need text"})
            try:
                return self._send(200, {"ok": True, "result": run_ai(FRAMING_PROMPT % (title, text))})
            except subprocess.TimeoutExpired:
                return self._send(504, {"ok": False, "error": "AI request timed out"})
            except Exception as exc:  # noqa: BLE001
                return self._send(500, {"ok": False, "error": str(exc)})
        if parsed.path == "/state":
            url = str(payload.get("url") or "").strip()
            state = payload.get("state")
            if not url or not isinstance(state, dict):
                return self._send(400, {"ok": False, "error": "need url and state object"})
            try:
                _write_state(url, state)
            except OSError as exc:
                return self._send(500, {"ok": False, "error": str(exc)})
            return self._send(200, {"ok": True})
        try:
            result = ai_answer(payload)
            return self._send(200, {"ok": True, "result": result})
        except subprocess.TimeoutExpired:
            return self._send(504, {"ok": False, "error": "AI request timed out"})
        except Exception as exc:  # noqa: BLE001
            return self._send(500, {"ok": False, "error": str(exc)})


def _private_dir(path):
    """Create `path` as 0700 — it holds the session token and the user's pages."""
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        path.chmod(0o700)
    except OSError:
        pass


def main():
    _private_dir(STATE_DIR)
    _private_dir(ARTICLES_DIR)
    _private_dir(STATE_STORE)

    # prune old articles
    cutoff = time.time() - 24 * 3600
    for f in ARTICLES_DIR.glob("*"):
        try:
            if f.stat().st_mtime < cutoff:
                f.unlink()
        except OSError:
            pass

    # prune long-forgotten annotation state (half a year)
    state_cutoff = time.time() - 180 * 24 * 3600
    for f in STATE_STORE.glob("*.json"):
        try:
            if f.stat().st_mtime < state_cutoff:
                f.unlink()
        except OSError:
            pass

    token = secrets.token_urlsafe(24)
    httpd = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    Handler.token = token
    port = httpd.server_address[1]
    # 0600: the token is a bearer credential for the loopback server and every
    # local user can connect to 127.0.0.1.
    fd = os.open(SERVER_JSON, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(json.dumps({"port": port, "token": token, "pid": os.getpid(), "build": BUILD}))
    try:
        httpd.serve_forever()
    finally:
        try:
            SERVER_JSON.unlink()
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
